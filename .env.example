# WA JEUN Environment Configuration
PORT=3000

# APP_URL: Public URL of the WA JEUN marketplace
APP_URL=https://wajeun.ng

# Optional: Supabase Production Persistence
# When provided, form submissions can sync directly to your Supabase PostgreSQL database.
# When omitted, the local atomic persistent store in ./data/ is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

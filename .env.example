# WA JEUN Environment Configuration
PORT=3000

# Development ignores forwarded IP headers and uses the direct socket peer.
# On Vercel, the app trusts the platform-managed X-Forwarded-For chain when
# VERCEL=1. Other production hosts require one of the explicit settings below.
# WAJEUN_CLIENT_IP_MODE=direct
# For a reverse proxy, use WAJEUN_CLIENT_IP_MODE=trusted-proxy and set
# WAJEUN_TRUSTED_PROXY_CIDRS to the verified proxy source IP/CIDR ranges.

# APP_URL: Public URL of the WA JEUN marketplace
APP_URL=https://wajeun.ng

# Flutterwave Standard sandbox only. These are server-only variables; never
# prefix them with VITE_. Checkout is hard-gated to NODE_ENV=development,
# FLW_MODE=test, and a test secret-key prefix. Production checkout stays off.
FLW_MODE=test
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# For callbacks during local testing, point APP_URL at a publicly reachable
# development tunnel that forwards to this local server. Never use live keys.

# Optional: server-side Supabase persistence
# Keep the secret key in this server-only environment file. Never prefix it with VITE_.
# When omitted in development, the local JSON store in ./data/ is used.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Browser Supabase Auth (public publishable key only; never put a server secret here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY above.
# SUPABASE_SERVICE_ROLE_KEY=
